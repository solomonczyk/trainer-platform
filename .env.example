# Trainer Platform — Environment Configuration
# Copy to .env and adjust before running

# Application
APP_NAME=TrainerPlatform
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key-in-production
REQUEST_ID_HEADER=X-Request-ID

# Database
DATABASE_URL=postgresql+asyncpg://trainer:trainer_pass@localhost:5432/trainer_platform
DATABASE_SYNC_URL=postgresql://trainer:trainer_pass@localhost:5432/trainer_platform

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# AI Gateway
AI_GATEWAY_PROVIDER=mock
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=gpt-4o-mini
AI_GATEWAY_TIMEOUT_SECONDS=30
AI_GATEWAY_MAX_RETRIES=1
AI_GATEWAY_FALLBACK_PLACEHOLDER_ENABLED=true

# OpenAI (real provider)
OPENAI_API_KEY=

# Analytics
ANALYTICS_ENABLED=true

# Feature Flags
FF_TRAINER_QA_INTERVIEW_VISIBLE=true
FF_TRAINER_QA_INTERVIEW_ENROLLMENT_ENABLED=true
FF_SCENARIO_RUNTIME_ENABLED=true
FF_AI_EVALUATION_ENABLED=true
FF_AI_EVALUATION_REAL_PROVIDER_ENABLED=false
FF_ANALYTICS_ENABLED=true
FF_LOCALE_EN_US_ENABLED=true
FF_BETA_ACCESS_ENABLED=false

# Localization
DEFAULT_LOCALE=ru-RU
FALLBACK_LOCALE=en-US

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Admin
ADMIN_API_KEY=change-me-admin-key
